# Add only the keys you have, in Vercel server-side Environment Variables.
# Providers are attempted in order; a failing provider falls through to the next configured key.
AI_PROVIDERS=gemini,groq,openrouter,openai

# Start here: Google AI Studio / Gemini API. Free quota depends on model and account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional alternatives (free access and limits vary).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional OpenAI provider; may require billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
APP_URL=https://ai-conv-help.vercel.app
